# ==============================================================================
# Variables d'environnement pour « Formulaire avis Blue 2.0 »
# ==============================================================================

# 1. Supabase (Projet Postgres gratuit pour la base de données)
# À récupérer dans le dashboard Supabase : Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Cloudflare R2 (Stockage Photos Haute Définition S3-compatible)
# Dashboard Cloudflare > R2 Object Storage
R2_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_BUCKET_NAME=blue2-avis-photos
# Optionnel : Domaine personnalisé ou URL publique r2.dev (ex: https://pub-xxxx.r2.dev ou https://photos.blue20.fr)
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxx.r2.dev

# 3. Sécurité de l'espace Administrateur (/admin)
ADMIN_PASSWORD=change_ce_mot_de_passe_secret_blue2

# 4. Vercel Cron (Protection du endpoint quotidien /api/cron/backup-and-keepalive)
CRON_SECRET=votre_secret_aleatoire_cron_32_caracteres

# 5. Sauvegarde GitHub automatique (Optionnel - Zéro perte de données)
GITHUB_BACKUP_REPO=Floiwd/blue2-avis-backups
GITHUB_BACKUP_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
