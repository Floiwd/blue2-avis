# ==============================================================================
# Variables d'environnement pour « Formulaire avis Blue 2.0 »
# ==============================================================================

# 1. Supabase (Projet gratuit Postgres & Storage)
# À récupérer dans le dashboard Supabase : Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Sécurité de l'espace Administrateur (/admin)
# Mot de passe requis pour accéder à l'administration
ADMIN_PASSWORD=change_ce_mot_de_passe_secret_blue2

# 3. Vercel Cron (Protection du endpoint quotidien /api/cron/backup-and-keepalive)
# Vercel injecte automatiquement CRON_SECRET lors de l'appel du cron
CRON_SECRET=votre_secret_aleatoire_cron_32_caracteres

# 4. Sauvegarde GitHub automatique (Optionnel - Zéro perte de données)
# Repo privé de sauvegarde et Personal Access Token (PAT) avec scope 'repo'
GITHUB_BACKUP_REPO=Floiwd/blue2-avis-backups
GITHUB_BACKUP_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
